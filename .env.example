# 複製這個檔案成 .env，填入你自己的金鑰。請勿把 .env 上傳到 GitHub。

# === 必填 ===

# KIE AI — 主要圖片生成 API。申請：https://kie.ai
KIE_AI_API_KEY=

# Cloudinary — 圖片上傳/CDN。免費註冊：https://cloudinary.com
# 註冊後在 Dashboard 取得這三個值。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === 選填（沒有也能跑，但功能會少）===

# fal.ai — 圖片生成備援（KIE 掛掉時用）。https://fal.ai
FAL_KEY=

# OpenRouter — AI 自動生成貼圖文字（character 模式）。https://openrouter.ai
OPENROUTER_API_KEY=
